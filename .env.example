# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL (public, safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon (publishable) key (public; RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Supabase service role key (SERVER ONLY, bypasses RLS, never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# GitHub App numeric id (read-only app: Contents + Metadata)
GITHUB_APP_ID=123456
# GitHub App slug from its URL (github.com/apps/<slug>), used for the install link
GITHUB_APP_SLUG=your-app-slug
# GitHub App OAuth client id
GITHUB_APP_CLIENT_ID=Iv1.your-client-id
# GitHub App OAuth client secret (server only)
GITHUB_APP_CLIENT_SECRET=your-client-secret
# GitHub App private key PEM with newlines escaped as \n (server only)
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Secret used to verify GitHub webhook signatures (server only)
GITHUB_WEBHOOK_SECRET=your-webhook-secret
# Anthropic API key for analysis and generation (server only)
ANTHROPIC_API_KEY=sk-ant-your-key
# Model id used for analysis and generation
ANALYSIS_MODEL=claude-sonnet-4-5
# Public base URL of this app, no trailing slash
APP_URL=http://localhost:3000
