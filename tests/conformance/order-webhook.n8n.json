{
  "name": "Order webhook alerts",
  "nodes": [
    {
      "id": "73d356bb-d405-4fcb-bbc1-14dbaaf141eb",
      "name": "Order Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "new-order",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "49fa7a37-083a-40a7-9dbc-48d77ee60ac7",
      "name": "Shape Order",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        470,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "7330faac-9abf-40bc-83f1-cc8cdcee489c",
              "name": "orderId",
              "value": "={{ $json.body.id }}",
              "type": "string"
            },
            {
              "id": "7430fc3f-9bbf-424f-84f1-ce1fddee4a2f",
              "name": "total",
              "value": "={{ $json.body.total }}",
              "type": "string"
            },
            {
              "id": "7530fdd2-9cbf-43e2-85f1-cfb2deee4bc2",
              "name": "source",
              "value": "webshop",
              "type": "string"
            },
            {
              "id": "7630ff65-9dbf-4575-86f1-d145dfee4d55",
              "name": "attempt",
              "value": 1,
              "type": "number"
            },
            {
              "id": "6f30f460-96bf-4a70-bff1-c640d8ee4250",
              "name": "reviewed",
              "value": false,
              "type": "boolean"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "7523f841-c7a7-4a51-a2e1-186123c36af1",
      "name": "Large Order",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        690,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 4
          },
          "conditions": [
            {
              "id": "e1c774e2-e405-4f52-aa7b-bcc2c3124a32",
              "leftValue": "={{ $json.total }}",
              "rightValue": 500,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "e2c77675-e505-40e5-ab7b-be55c4124bc5",
              "leftValue": "={{ $json.source }}",
              "rightValue": "webshop",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "3a3bf569-7cd9-4e99-b42e-aa096859fbb9",
      "name": "Notify Sales",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        910,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_SLACK_CHANNEL"
        },
        "messageType": "text",
        "text": "=Large order {{ $json.orderId }} worth {{ $json.total }}",
        "otherOptions": {}
      }
    },
    {
      "id": "339a11af-8f32-4e1f-ab43-4fcf9dcae0bf",
      "name": "Email Team",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        910,
        460
      ],
      "parameters": {
        "operation": "send",
        "fromEmail": "YOUR_FROM_EMAIL",
        "toEmail": "YOUR_TEAM_EMAIL",
        "subject": "=New order {{ $json.orderId }}",
        "emailFormat": "text",
        "text": "=A new order arrived.\nTotal: {{ $json.total }}",
        "options": {}
      }
    },
    {
      "id": "b4a624c4-51ae-4234-af53-16648cdc1f54",
      "name": "Join Branches",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1130,
        300
      ],
      "parameters": {
        "mode": "append",
        "numberInputs": 2
      }
    },
    {
      "id": "ad33fe69-fdd5-4d19-a407-30c9ae311379",
      "name": "Reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1350,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"received\": true, \"status\": \"queued\", \"note\": \"Thanks, we got \\\"it\\\"\"}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Order Webhook": {
      "main": [
        [
          {
            "node": "Shape Order",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Shape Order": {
      "main": [
        [
          {
            "node": "Large Order",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Large Order": {
      "main": [
        [
          {
            "node": "Notify Sales",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Email Team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Sales": {
      "main": [
        [
          {
            "node": "Join Branches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email Team": {
      "main": [
        [
          {
            "node": "Join Branches",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Join Branches": {
      "main": [
        [
          {
            "node": "Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
